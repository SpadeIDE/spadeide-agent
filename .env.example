# macOS code signing + notarization for public Agent.app DMGs.
# Copy to .env and fill in (.env is gitignored).
#
# 1. Apple Developer → Certificates → Developer ID Application (install in Keychain)
# 2. appleid.apple.com → App-Specific Passwords
# 3. developer.apple.com → Membership → Team ID

APPLE_ID=you@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX

# Optional — auto-detected from Keychain if omitted:
# CSC_NAME=Developer ID Application: Your Name (XXXXXXXXXX)

# Force unsigned ad-hoc builds even when MAC_RELEASE=1:
# SKIP_MAC_SIGN=1

# Skip platforms in ./scripts/build-release.sh:
# SKIP_MAC=1
# SKIP_LINUX=1
# SKIP_DEB=1
# SKIP_SERVER=1

# Dev only — skip hard failures in ./scripts/build-release.sh:
# ALLOW_UNSIGNED_RELEASE=1
