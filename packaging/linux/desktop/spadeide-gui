def agent_dir() -> Path:
    """Mirror config.DefaultDir(): SPADE_AGENT_HOME → system → ~/.spade-agent."""
    home = os.environ.get("SPADE_AGENT_HOME", "").strip()
    if home:
        return Path(home)
    if os.environ.get("SPADE_AGENT_MODE", "").strip() == "system":
        return SYSTEM_STATE_DIR
    if os.geteuid() == 0 and (SYSTEM_STATE_DIR / "control.token").is_file():
        return SYSTEM_STATE_DIR
    return Path.home() / ".spade-agent"


