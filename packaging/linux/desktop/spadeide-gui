    def _place_near_panel(self):
        try:
            gdk_win = self.get_window()
            display = self.get_display()
            monitor = None
            if gdk_win:
                monitor = display.get_monitor_at_window(gdk_win)
            if monitor is None:
                monitor = display.get_primary_monitor()
            if monitor is None:
                return False
            geo = monitor.get_geometry()
            w = self.get_allocated_width() or 360
            self.move(geo.x + geo.width - w - 16, geo.y + 32)
        except Exception:
            pass
        return False

    def _on_delete(self, *_args):
        if self.app.indicator:
            self.hide()
            return True
        return False

    def _boot(self):
        try:
            api("GET", "/v1/status")
        except RuntimeError:
            start_agent()
        self.refresh()
        return False

    def _tick(self):
        if not self._busy:
            self.refresh()
            if self.app.settings_win and self.app.settings_win.get_visible():
                self.app.settings_win.refresh()
        return True

    def refresh(self):
        try:
            st = api("GET", "/v1/status")
        except RuntimeError as e:
            self._running = False
            self._subtitle.set_markup('<span color="#8B9AAB" size="11000" weight="medium">Stopped</span>')
            self._host.set_text("Start the agent to pair an iPad.")
            self._fp.set_text("")
            self._error.set_text(str(e) if "not running" not in str(e) else "")
            self._qr_stamp = ""
            self._show_qr("")
            self._sync_run_buttons()
            self.app.set_running(False)
            return
        self._running = True
        self._error.set_text("")
        n = len(st.get("clients") or [])
        if n == 1:
            cap = "Running · 1 client"
        elif n > 1:
            cap = f"Running · {n} clients"
        else:
            cap = "Running"
        self._subtitle.set_markup(
            f'<span color="#2EA86A" size="11000" weight="medium">{cap}</span>'
        )
        self._version.set_markup(
            f'<span size="10000" font_family="monospace">{st.get("version") or ""}</span>'
        )
        ip, port = st.get("ip") or "127.0.0.1", st.get("port") or 7422
        self._host.set_text(f"{ip}:{int(port)}")
        fp = st.get("fingerprint") or ""
        short = fp[:12] + "…" if len(fp) > 12 else fp
        self._fp.set_text(short)
        self._remote.handler_block_by_func(self._on_remote)
        self._remote.set_active(bool(st.get("remoteAccess")))
        self._remote.handler_unblock_by_func(self._on_remote)
        self._render_devices(st.get("devices") or [])
        stamp = st.get("pairURL") or ""
        if stamp != self._qr_stamp or (stamp and not self._qr_ok):
            self._qr_stamp = stamp
            self._show_qr(stamp)
        self._sync_run_buttons()
        self.app.set_running(True)

    def _sync_run_buttons(self):
        self._btn_start.set_visible(not self._running)
        self._btn_stop.set_visible(self._running)
        self._btn_restart.set_visible(self._running)

    def _show_qr(self, url: str):
        if not url:
            self._qr.set_from_pixbuf(_white_pixbuf(148))
            self._qr_ok = False
            return
        pix = qr_pixbuf(url, 148)
        if pix is None:
            self._qr.set_from_pixbuf(_white_pixbuf(148))
            self._qr_ok = False
            return
        self._qr.set_from_pixbuf(pix)
        self._qr_ok = True

    def _render_devices(self, devices: list):
        for child in list(self._devices.get_children()):
            self._devices.remove(child)
        if not devices:
            empty = Gtk.Label(label="No paired iPads yet.", xalign=0)
            empty.get_style_context().add_class("spade-muted")
            self._devices.add(empty)
        else:
            for d in devices:
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                row.get_style_context().add_class("spade-card")
                dot = Gtk.Label(label="●" if d.get("online") else "○")
                name = Gtk.Label(label=d.get("name") or "iPad", xalign=0)
                ident = Gtk.Label(label=(d.get("id") or "")[:8], xalign=0)
                ident.get_style_context().add_class("spade-muted")
                btn = Gtk.Button(label="×")
                btn.get_style_context().add_class("spade-plain")
                btn.connect("clicked", lambda _b, i=d.get("id"): self._unpair(i))
                row.pack_start(dot, False, False, 0)
                row.pack_start(name, True, True, 0)
                row.pack_start(ident, False, False, 0)
                row.pack_end(btn, False, False, 0)
                self._devices.add(row)
        self._devices.show_all()

    def _on_remote(self, switch, *_):
        try:
            api("POST", "/v1/remote", {"enabled": bool(switch.get_active())})
        except RuntimeError as e:
            self._error.set_text(str(e))
        self.refresh()

    def _on_copy(self, *_):
        try:
            st = api("GET", "/v1/status")
        except RuntimeError as e:
            self._error.set_text(str(e))
            return
        url = st.get("pairURL") or ""
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(url, -1)
        self._copy.set_label("Copied")
        GLib.timeout_add_seconds(2, lambda: self._copy.set_label("Copy pair URL") or False)

    def _on_rotate(self, *_):
        try:
            api("POST", "/v1/pair/rotate")
        except RuntimeError as e:
            self._error.set_text(str(e))
        self._qr_stamp = ""
        self.refresh()

    def _on_reset(self, *_):
        dlg = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text="Remove all paired devices?",
        )
        dlg.format_secondary_text("iPads will need to scan the QR again.")
        resp = dlg.run()
        dlg.destroy()
        if resp != Gtk.ResponseType.OK:
            return
        try:
            api("POST", "/v1/pair/reset")
        except RuntimeError as e:
            self._error.set_text(str(e))
        self.refresh()

    def _unpair(self, device_id: str):
        if not device_id:
            return
        try:
            api("DELETE", f"/v1/pair/devices/{device_id}")
        except RuntimeError as e:
            self._error.set_text(str(e))
        self.refresh()

    def _on_start(self, *_):
        start_agent()
        GLib.timeout_add(600, lambda: self.refresh() or False)

    def _on_stop(self, *_):
        stop_agent()
        self.refresh()

    def _on_restart(self, *_):
        stop_agent()

        def go():
            start_agent()
            self.refresh()
            return False

        GLib.timeout_add(400, go)

    def _on_config(self, *_):
        AGENT_DIR.mkdir(parents=True, exist_ok=True)
        subprocess.Popen(["xdg-open", str(AGENT_DIR)])

    def _on_logs(self, *_):
        log = AGENT_DIR / "agent.log"
        log.parent.mkdir(parents=True, exist_ok=True)
        log.touch(exist_ok=True)
        subprocess.Popen(["xdg-open", str(log)])


class SettingsWindow(Gtk.Window):
    def __init__(self, app: "AgentApplication"):
        super().__init__(title="SpadeIDE Agent Settings")
        self.app = app
        self.set_default_size(480, 1)
        self.set_resizable(False)
        apply_window_icon(self)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title("Settings")
        self.set_titlebar(header)
        self.connect("delete-event", self._on_delete)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        body.set_margin_top(20)
        body.set_margin_bottom(22)
        body.set_margin_start(22)
        body.set_margin_end(22)

        body.add(section_label("Remote"))
        rv_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        rv_box.get_style_context().add_class("spade-card")
        rv_title = Gtk.Label(label="Rendezvous URL", xalign=0)
        rv_sub = Gtk.Label(
            label="Introducer for off-LAN connect. Same URL as on the iPad. Leave empty for the product host.",
            xalign=0,
            wrap=True,
        )
        rv_sub.get_style_context().add_class("spade-muted")
        rv_box.add(rv_title)
        rv_box.add(rv_sub)
        self._rv = Gtk.Entry()
        self._rv.set_placeholder_text(PRODUCT_RV)
        self._rv.connect("activate", self._on_rv_apply)
        rv_box.add(self._rv)
        rv_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self._rv_save = Gtk.Button(label="Apply")
        self._rv_save.get_style_context().add_class("spade-ghost")
        self._rv_save.connect("clicked", self._on_rv_apply)
        rv_row.add(self._rv_save)
        self._rv_status = Gtk.Label(xalign=0, wrap=True)
        self._rv_status.get_style_context().add_class("spade-muted")
        rv_row.pack_start(self._rv_status, True, True, 0)
        rv_box.add(rv_row)
        body.add(rv_box)

        body.add(section_label("Startup"))
        login_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        login_row.get_style_context().add_class("spade-card")
        login_info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        login_title = Gtk.Label(label="Launch at login", xalign=0)
        login_sub = Gtk.Label(label="Show the tray when you sign in.", xalign=0)
        login_sub.get_style_context().add_class("spade-muted")
        login_info.pack_start(login_title, False, False, 0)
        login_info.pack_start(login_sub, False, False, 0)
        self._login = Gtk.Switch()
        self._login.set_valign(Gtk.Align.CENTER)
        self._login.set_active(autostart_enabled())
        self._login.connect("notify::active", self._on_login)
        login_row.pack_start(login_info, True, True, 0)
        login_row.pack_end(self._login, False, False, 0)
        body.add(login_row)

        body.add(section_label("About"))
        about = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        about.get_style_context().add_class("spade-card")
        self._about_ver = Gtk.Label(xalign=0)
        about.add(self._about_ver)
        body.add(about)

        self._error = Gtk.Label(xalign=0, wrap=True)
        self._error.get_style_context().add_class("spade-danger")
        body.add(self._error)

        self.add(body)
        self.show_all()
        self.refresh()

    def _on_delete(self, *_args):
        self.hide()
        return True

    def refresh(self):
        try:
            st = api("GET", "/v1/status")
        except RuntimeError:
            self._about_ver.set_text("Version  —")
            self._rv_status.set_text("Agent is not running.")
            return
        self._about_ver.set_text(f"Version    {st.get('version') or '—'}")
        if not self._rv.has_focus():
            srv = (st.get("remoteServer") or "").strip()
            if srv == PRODUCT_RV:
                srv = ""
            if self._rv.get_text() != srv:
                self._rv.set_text(srv)
        if not st.get("remoteAccess"):
            self._rv_status.set_text("Turn on Remote access in the tray to use this off the LAN.")
        elif st.get("remoteRegistered"):
            self._rv_status.set_text("Registered on rendezvous.")
        else:
            self._rv_status.set_text("Not registered — check the URL and network.")

    def _on_rv_apply(self, *_):
        url = (self._rv.get_text() or "").strip()
        try:
            api("POST", "/v1/remote", {"server": url})
            self._error.set_text("")
        except RuntimeError as e:
            self._error.set_text(str(e))
        self.refresh()

    def _on_login(self, switch, *_):
        set_autostart(bool(switch.get_active()))


class AgentApplication(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.win: AgentWindow | None = None
        self.settings_win: SettingsWindow | None = None
        self.indicator = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        GLib.set_prgname("spadeide")
        GLib.set_application_name("SpadeIDE Agent")
        screen = Gdk.Screen.get_default()
        css = Gtk.CssProvider()
        css.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            screen, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        settings = Gtk.Settings.get_default()
        if settings:
            settings.set_property("gtk-application-prefer-dark-theme", True)
        self._setup_tray()
        if self.indicator:
            self.hold()

    def do_activate(self):
        if self.win is None:
            self.win = AgentWindow(self)
        self.toggle_popover(force_show=True)

    def toggle_popover(self, force_show: bool = False):
        if self.win is None:
            self.win = AgentWindow(self)
        if self.win.get_visible() and not force_show:
            self.win.hide()
            return
        self.win.show_all()
        self.win._sync_run_buttons()
        self.win.present()
        GLib.idle_add(self.win._place_near_panel)

    def show_settings(self):
        if self.settings_win is None:
            self.settings_win = SettingsWindow(self)
        self.settings_win.show_all()
        self.settings_win.present()
        self.settings_win.refresh()

    def set_running(self, _running: bool):
        return

    def _setup_tray(self):
        mod = _try_appindicator()
        if mod is None:
            return
        self._AppInd = mod
        try:
            icon_path = panel_icon_file()
            ind = mod.Indicator.new(
                APP_ID,
                "spadeide-panel",
                mod.IndicatorCategory.APPLICATION_STATUS,
            )
            for theme_dir in (
                "/usr/share/pixmaps",
                "/usr/share/icons/hicolor/24x24/status",
                "/usr/share/icons/hicolor/24x24/apps",
            ):
                if Path(theme_dir).is_dir():
                    try:
                        ind.set_icon_theme_path(theme_dir)
                        break
                    except Exception:
                        pass
            if icon_path:
                try:
                    ind.set_icon_full(icon_path, "SpadeIDE Agent")
                except Exception:
                    ind.set_icon("spadeide-panel")
            else:
                ind.set_icon("spadeide-panel")
            ind.set_status(mod.IndicatorStatus.ACTIVE)
            ind.set_title("SpadeIDE Agent")
            menu = Gtk.Menu()
            open_item = Gtk.MenuItem(label="Open")
            open_item.connect("activate", lambda *_: self.toggle_popover(force_show=True))
            menu.append(open_item)
            settings_item = Gtk.MenuItem(label="Settings")
            settings_item.connect("activate", lambda *_: self.show_settings())
            menu.append(settings_item)
            quit_item = Gtk.MenuItem(label="Quit")
            quit_item.connect("activate", lambda *_: self.quit())
            menu.append(quit_item)
            menu.show_all()
            ind.set_menu(menu)
            try:
                if hasattr(ind, "set_item_is_menu"):
                    ind.set_item_is_menu(False)
            except Exception:
                pass
            try:
                ind.set_secondary_activate_target(open_item)
            except Exception:
                pass
            self.indicator = ind
        except Exception:
            self.indicator = None


def main() -> int:
    return AgentApplication().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
