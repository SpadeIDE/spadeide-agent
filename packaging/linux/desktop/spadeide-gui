def _control_port() -> int:
    path = AGENT_DIR / "control.port"
    try:
        n = int(path.read_text().strip())
        if n > 0:
            return n
    except (OSError, ValueError):
        pass
    return 7423


def _token() -> str:
    env = os.environ.get("SPADE_CONTROL_TOKEN", "").strip()
    if env:
        return env
    try:
        return (AGENT_DIR / "control.token").read_text().strip()
    except OSError:
        return ""


def api(method: str, path: str, body: dict | None = None):
    req = urllib.request.Request(
        f"http://127.0.0.1:{_control_port()}{path}",
        method=method,
    )
    tok = _token()
    if tok:
        req.add_header("Authorization", f"Bearer {tok}")
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, data=data, timeout=3) as res:
            payload = res.read()
            ctype = res.headers.get("Content-Type", "")
            if "json" in ctype:
                return json.loads(payload.decode() or "{}")
            return payload
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"{e.code} {e.reason}") from e
    except OSError as e:
        raise RuntimeError("agent is not running") from e


def load_png(data: bytes, size: int | None = None) -> GdkPixbuf.Pixbuf | None:
    try:
        loader = GdkPixbuf.PixbufLoader.new_with_type("png")
        loader.write(data)
        loader.close()
        pix = loader.get_pixbuf()
        if pix and size:
            return pix.scale_simple(size, size, GdkPixbuf.InterpType.BILINEAR)
        return pix
    except GLib.Error:
        return None


def _white_pixbuf(size: int) -> GdkPixbuf.Pixbuf:
    pix = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, False, 8, size, size)
    pix.fill(0xFFFFFFFF)
    return pix


def qr_pixbuf(url: str, size: int = 148) -> GdkPixbuf.Pixbuf | None:
    try:
        raw = api("GET", "/v1/pair/qr.png")
        if isinstance(raw, bytes):
            pix = load_png(raw, size)
            if pix:
                return pix
    except RuntimeError:
        pass
    if not url:
        return None
    try:
        import qrcode
        from io import BytesIO

        qr = qrcode.QRCode(
            error_correction=qrcode.constants.ERROR_CORRECT_L,
            box_size=10,
            border=2,
        )
        qr.add_data(url)
        qr.make(fit=True)
        img = qr.make_image(fill_color="black", back_color="white")
        buf = BytesIO()
        img.save(buf, format="PNG")
        return load_png(buf.getvalue(), size)
    except Exception:
        return None


def which_spadeide() -> str:
    return shutil.which("spadeide") or "/usr/bin/spadeide"


def start_agent() -> None:
    r = subprocess.run(
        ["systemctl", "--user", "start", "spade-agent"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if r.returncode == 0:
        return
    subprocess.Popen(
        [which_spadeide(), "serve"],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def stop_agent() -> None:
    subprocess.run(
        ["systemctl", "--user", "stop", "spade-agent"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    subprocess.run(
        [which_spadeide(), "stop"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def autostart_enabled() -> bool:
    if USER_AUTOSTART.exists():
        text = USER_AUTOSTART.read_text(errors="ignore")
        for line in text.splitlines():
            if line.strip().lower() == "hidden=true":
                return False
        return True
    return SYSTEM_AUTOSTART.exists()


def set_autostart(enabled: bool) -> None:
    USER_AUTOSTART.parent.mkdir(parents=True, exist_ok=True)
    src = DESKTOP_SRC if DESKTOP_SRC.exists() else SYSTEM_AUTOSTART
    if src.exists():
        text = src.read_text()
    else:
        text = (
            "[Desktop Entry]\n"
            "Type=Application\n"
            "Name=SpadeIDE Agent\n"
            "Exec=spadeide-gui\n"
            "Icon=spadeide\n"
            "Terminal=false\n"
        )
    lines = [ln for ln in text.splitlines() if not ln.lower().startswith("hidden=")]
    if not enabled:
        lines.append("Hidden=true")
    USER_AUTOSTART.write_text("\n".join(lines) + "\n")


def _try_appindicator():
    for ns in ("AyatanaAppIndicator3", "AppIndicator3"):
        try:
            gi.require_version(ns, "0.1")
            return getattr(__import__("gi.repository", fromlist=[ns]), ns)
        except (ValueError, ImportError, AttributeError):
            continue
    return None


def icon_file() -> str | None:
    for p in ICON_PATHS:
        if p.is_file():
            return str(p)
    return None


def panel_icon_file() -> str | None:
    for p in PANEL_ICON_PATHS:
        if p.is_file():
            return str(p)
    return icon_file()


def apply_window_icon(win: Gtk.Window) -> None:
    path = icon_file()
    if not path:
        Gtk.Window.set_default_icon_name("spadeide")
        win.set_icon_name("spadeide")
        return
    try:
        Gtk.Window.set_default_icon_from_file(path)
        win.set_icon_from_file(path)
    except GLib.Error:
        win.set_icon_name("spadeide")


def section_label(title: str) -> Gtk.Label:
    lab = Gtk.Label(xalign=0)
    lab.set_markup(
        f'<span size="9000" weight="semibold" letter_spacing="800">{title.upper()}</span>'
    )
    lab.get_style_context().add_class("spade-muted")
    return lab


def hairline() -> Gtk.Widget:
    line = Gtk.EventBox()
    line.set_size_request(-1, 1)
    line.get_style_context().add_class("spade-hairline")
    return line


def _plain_button(label: str, cb) -> Gtk.Button:
    b = Gtk.Button(label=label)
    b.get_style_context().add_class("spade-plain")
    b.connect("clicked", cb)
    return b


