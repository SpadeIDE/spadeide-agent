[Unit]
Description=SpadeIDE Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/spadeide serve --foreground --port 7422 --control-port 7423
Restart=on-failure
RestartSec=3
# Login shell PATH (nvm, cargo, …) is not in systemd's env — the agent
# starts $SHELL -l for PTYs, so interactive terminals still get the profile.
Environment=HOME=%h

[Install]
WantedBy=default.target
