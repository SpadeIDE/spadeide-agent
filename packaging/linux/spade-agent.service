[Unit]
Description=SpadeIDE Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
NoNewPrivileges=false
ExecStart=/usr/local/bin/spadeide serve --foreground --port 7422 --control-port 7423
Restart=on-failure
RestartSec=3
WorkingDirectory=/var/lib/spade-agent
Environment=HOME=/var/lib/spade-agent
Environment=SPADE_AGENT_HOME=/var/lib/spade-agent
Environment=SPADE_AGENT_MODE=system

# Privileged broker: pairing is still the QR; each tablet then Unix-logs in
# once and is jailed to that account's $HOME. The PTY is that user, never root.
# State (pairings, identity) lives in /var/lib/spade-agent — not /root.

[Install]
WantedBy=multi-user.target
